#This database is prepared for testlab cosmic setup.
# MOLLER polarimeter: 3 XY layers(m0-m5) + 2 UV layer(m6-m7)
#Please remove UV GEM while using only Polarimeter XY GEMs

--------[ 2026-04-26 00:00:00 ]

# ======================================================================
# Module inventory
# ======================================================================
# XY chamber has two virtual modules per physical layer:
#   layer 0: m0 m1
#   layer 1: m2 m3
#   layer 2: m4 m5
# UV/MOLLER coordinate GEM:
#   layer 3: m6
# ======================================================================

mollerPol.polgem.modules = m0 m1 m2 m3 m4 m5 m6 m7

# ----------------------------------------------------------------------
# Layer indices
# ----------------------------------------------------------------------
mollerPol.polgem.m0.layer = 0
mollerPol.polgem.m1.layer = 0

