th1d hmollerPol_polgem_m0_clustSizeV_all 'mollerPol.polgem.m0; Cluster Size, V/Y strips;' mollerPol.polgem.m0.clust.clustv_strips[I] 10 -0.5 9.5 #mollerPol.polgem.m0.strip.IsV[I]


