th1d hmollerPol_polgem_m0_ADCmaxV_all 'mollerPol.polgem.m0; Strip ADC max, V/Y strips; ' mollerPol.polgem.m0.strip.ADCmax[I] 500 0 2000 mollerPol.polgem.m0.strip.IsV[I]
th1d hmollerPol_polgem_m0_TimeU_all 'mollerPol.polgem.m0; Strip Time, U/X strips;' mollerPol.polgem.m0.strip.Tmean[I] 150 0 150 mollerPol.polgem.m0.strip.IsU[I]
th1d hmollerPol_polgem_m0_TimeV_all 'mollerPol.polgem.m0; Strip Time, V/Y strips;' mollerPol.polgem.m0.strip.Tmean[I] 150 0 150 mollerPol.polgem.m0.strip.IsV[I]
th1d hmollerPol_polgem_m0_iSampMaxU_all 'mollerPol.polgem.m0; Peak time sample, U/X strips;' mollerPol.polgem.m0.strip.isampmax[I] 6 -0.5 5.5 mollerPol.polgem.m0.strip.IsU[I]
th1d hmollerPol_polgem_m0_iSampMaxV_all 'mollerPol.polgem.m0; Peak time sample, V/Y strips;' mollerPol.polgem.m0.strip.isampmax[I] 6 -0.5 5.5 mollerPol.polgem.m0.strip.IsV[I]
th2d hmollerPol_polgem_m0_ADCsum_vs_Ustrip_all 'mollerPol.polgem.m0; U strip ADC sum vs strip;' mollerPol.polgem.m0.strip.istrip[I] mollerPol.polgem.m0.strip.ADCsum[I] 192 -0.5 191.5 250 0 12000 mollerPol.polgem.m0.strip.IsU[I]
th2d hmollerPol_polgem_m0_ADCsum_vs_Vstrip_all 'mollerPol.polgem.m0; V strip ADC sum vs strip;' mollerPol.polgem.m0.strip.istrip[I] mollerPol.polgem.m0.strip.ADCsum[I] 640 -0.5 639.5 250 0 12000 mollerPol.polgem.m0.strip.IsV[I]
th2d hmollerPol_polgem_m0_ADCmax_vs_Ustrip_all 'mollerPol.polgem.m0; U strip ADC max vs strip;' mollerPol.polgem.m0.strip.istrip[I] mollerPol.polgem.m0.strip.ADCmax[I] 192 -0.5 191.5 250 0 4000 mollerPol.polgem.m0.strip.IsU[I]
th2d hmollerPol_polgem_m0_ADCmax_vs_Vstrip_all 'mollerPol.polgem.m0; V strip ADC max vs strip;' mollerPol.polgem.m0.strip.istrip[I] mollerPol.polgem.m0.strip.ADCmax[I] 640 -0.5 639.5 250 0 4000 mollerPol.polgem.m0.strip.IsV[I]
th1d hmollerPol_polgem_m0_hit_xlocal 'Hit local X position (m), Module 0' mollerPol.polgem.m0.hit.hitx[I] 200 -0.040 0.040 #mollerPol.polgem.m0.hit.ontrack[I]
th1d hmollerPol_polgem_m0_hit_ylocal 'Hit local Y position (m), Module 0' mollerPol.polgem.m0.hit.hity[I] 700 -0.15 0.15 #mollerPol.polgem.m0.hit.ontrack[I]
