#tree variables:
block mollerPol.polgem.track.*
block mollerPol.polgem.hit.*
block mollerPol.polgem.*
variable mollerPol.polgem.nlayershit
variable mollerPol.polgem.nlayershitu
variable mollerPol.polgem.nlayershitv
variable mollerPol.polgem.nlayershituv
variable mollerPol.polgem.nstripsu_layer
variable mollerPol.polgem.nstripsv_layer
variable mollerPol.polgem.nclustu_layer
variable mollerPol.polgem.nclustv_layer
variable mollerPol.polgem.n2Dhit_layer
#block mollerPol.polgem.*.time.T0_by_APV
#block mollerPol.polgem.*.time.Tref_coarse
#block mollerPol.polgem.*.time.Tcoarse_by_APV
#block mollerPol.polgem.*.time.Tfine_by_APV
#block mollerPol.polgem.*.time.EventCount_by_APV
#block mollerPol.polgem.*.time.T_ns_by_APV

#Cuts:
cut singletrack mollerPol.polgem.track.ntrack==1
cut anytrack mollerPol.polgem.track.ntrack>0
# Histogram definitions:
# layers fired, strip and cluster multiplicities
th1d hmollerPol_polgem_Nlayers_hit ';Number of layers with fired strips (u/x OR v/y);' mollerPol.polgem.nlayershit 6 -0.5 5.5
th1d hmollerPol_polgem_Nlayers_hitu ';Number of layers with fired U/X strips;' mollerPol.polgem.nlayershitu 6 -0.5 5.5
th1d hmollerPol_polgem_Nlayers_hitv ';Number of layers with fired V/Y strips;' mollerPol.polgem.nlayershitv 6 -0.5 5.5
th1d hmollerPol_polgem_Nlayers_hituv ';Number of layers with 2D hits;' mollerPol.polgem.nlayershituv 6 -0.5 5.5

th2d hmollerPol_polgem_NstripsU_layer ';layer;Number of U/X strips fired' [I] mollerPol.polgem.nstripsu_layer[I] 5 -0.5 4.5 101 -0.5 100.5
th2d hmollerPol_polgem_NstripsV_layer ';layer;Number of V/Y strips fired' [I] mollerPol.polgem.nstripsv_layer[I] 5 -0.5 4.5 101 -0.5 100.5
th2d hmollerPol_polgem_NclustU_layer ';layer;Number of U/X clusters' [I] mollerPol.polgem.nclustu_layer[I] 5 -0.5 4.5 51 -0.5 50.5
th2d hmollerPol_polgem_NclustV_layer ';layer;Number of V/Y clusters' [I] mollerPol.polgem.nclustv_layer[I] 5 -0.5 4.5 51 -0.5 50.5
th2d hmollerPol_polgem_Nclust2D_layer ';layer;Number of 2D hits' [I] mollerPol.polgem.n2Dhit_layer[I] 5 -0.5 4.5 51 -0.5 50.5

th1d hmollerPol_polgem_clustwidthU 'U/X clusters on tracks; cluster size in strips' mollerPol.polgem.hit.nstripu 10 0.5 10.5 singletrack
th1d hmollerPol_polgem_clustwidthV 'V/Y clusters on tracks; cluster size in strips' mollerPol.polgem.hit.nstripv 10 0.5 10.5 singletrack
th2d hmollerPol_polgem_clustwidthVvsU '2D hits on tracks; U/X cluster size ; V/Y cluster size' mollerPol.polgem.hit.nstripu mollerPol.polgem.hit.nstripv 10 0.5 10.5 10 0.5 10.5 singletrack
th2d hmollerPol_polgem_clustwidthU_vs_module ';module;U/X cluster size' mollerPol.polgem.hit.module mollerPol.polgem.hit.nstripu 20 -0.5 19.5 10 0.5 10.5 singletrack
th2d hmollerPol_polgem_clustwidthV_vs_module ';module;V/Y cluster size' mollerPol.polgem.hit.module mollerPol.polgem.hit.nstripv 20 -0.5 19.5 10 0.5 10.5 singletrack
th1d hmollerPol_polgem_clust_Utime ';U/X cluster time (ns);' mollerPol.polgem.hit.Utime 150 0 150 singletrack
th1d hmollerPol_polgem_clust_Vtime ';V/Y cluster time (ns);' mollerPol.polgem.hit.Vtime 150 0 150 singletrack
th2d hmollerPol_polgem_clust_UVtime ';U/X cluster time (ns); V/Y cluster time (ns)' mollerPol.polgem.hit.Utime mollerPol.polgem.hit.Vtime 150 0 150 150 0 150 singletrack
th1d hmollerPol_polgem_clust_deltat ';t_{U/X} - t_{V/Y} (ns);' mollerPol.polgem.hit.deltat 200 -50 50 singletrack
th2d hmollerPol_polgem_clust_deltat_vs_tavg ';t_{avg} (ns); t_{diff} (ns)' mollerPol.polgem.hit.Tavg mollerPol.polgem.hit.deltat 150 0 150 200 -50 50 singletrack
th1d hmollerPol_polgem_iSampMaxU ';Peak time sample, U/X strips;' mollerPol.polgem.hit.isampmaxUclust 6 -0.5 5.5
th1d hmollerPol_polgem_iSampMaxV ';Peak time sample, V/Y strips;' mollerPol.polgem.hit.isampmaxVclust 6 -0.5 5.5
th1d hmollerPol_polgem_CorrCoeff_clust ';Corr. Coeff., cluster sums;' mollerPol.polgem.hit.ccor_clust 202 -1.01 1.01 singletrack
th1d hmollerPol_polgem_CorrCoeff_maxstrip ';Corr. Coeff., max strips;' mollerPol.polgem.hit.ccor_strip 202 -1.01 1.01 singletrack
th1d hmollerPol_polgem_ADCasym ';(ADCU-ADCV)/(ADCU+ADCV)' mollerPol.polgem.hit.ADCasym 202 -1.01 1.01 singletrack

th1d hmollerPol_polgem_ADCavg 'hits on tracks ;(ADCU+ADCV)/2;' mollerPol.polgem.hit.ADCavg 1500 0 30000 singletrack
th2d hmollerPol_polgem_ADCasym_vs_ADCavg ';ADC avg;ADC asym.' mollerPol.polgem.hit.ADCavg mollerPol.polgem.hit.ADCasym 250 0 25000 250 -1.01 1.01
th1d hmollerPol_polgem_ADCU_clust ';ADC cluster sum (U/X strips);' mollerPol.polgem.hit.ADCU 1500 0 30000 singletrack
th1d hmollerPol_polgem_ADCV_clust ';ADC cluster sum (V/Y strips);' mollerPol.polgem.hit.ADCV 1500 0 30000 singletrack
th2d hmollerPol_polgem_ADCVvsU_clust ';ADC cluster sum (U/X); ADC cluster sum (V/Y)' mollerPol.polgem.hit.ADCU mollerPol.polgem.hit.ADCV 200 0 30000 200 0 30000 singletrack
th2d hmollerPol_polgem_ADCavg_vs_module ';module; Cluster ADC avg' mollerPol.polgem.hit.module mollerPol.polgem.hit.ADCavg 20 -0.5 19.5 250 0 25000
th1d hmollerPol_polgem_ADCU_maxstrip ';Max strip ADC sum (U/X strips);' mollerPol.polgem.hit.ADCmaxstripU 1500 0 15000 singletrack
th1d hmollerPol_polgem_ADCV_maxstrip ';Max strip ADC sum (V/Y strips);' mollerPol.polgem.hit.ADCmaxstripV 1500 0 15000 singletrack
th2d hmollerPol_polgem_ADCVvsU_maxstrip ';Max strip ADC sum (U/X); Max strip ADC sum (V/Y)' mollerPol.polgem.hit.ADCmaxstripU mollerPol.polgem.hit.ADCmaxstripV 200 0 12000 200 0 12000 singletrack
th1d hmollerPol_polgem_ADCU_maxsample ';U/X max strip max sample;' mollerPol.polgem.hit.ADCmaxsampU 500 0 4000 singletrack
th1d hmollerPol_polgem_ADCV_maxsample ';V/Y max strip max sample;' mollerPol.polgem.hit.ADCmaxsampV 500 0 4000 singletrack
th2d hmollerPol_polgem_ADCVvsU_maxsample ';Max strip max sample (U/X);Max strip max sample (V/Y)' mollerPol.polgem.hit.ADCmaxsampU mollerPol.polgem.hit.ADCmaxsampV 200 0 4000 200 0 4000 singletrack
th1d hmollerPol_polgem_ADCU_maxclustsample ';Max cluster-summed U/X sample;' mollerPol.polgem.hit.ADCmaxsampUclust 500 0 8000 singletrack
th1d hmollerPol_polgem_ADCV_maxclustsample ';Max cluster-summed V/Y sample;' mollerPol.polgem.hit.ADCmaxsampVclust 500 0 8000 singletrack
th2d hmollerPol_polgem_ADCVvsU_maxclustsample ';Max cluster-summed sample (U/X);Max cluster-summed sample (V/Y)' mollerPol.polgem.hit.ADCmaxsampUclust mollerPol.polgem.hit.ADCmaxsampVclust 200 0 8000 200 0 8000 singletrack

th1d hmollerPol_polgem_Ntracks ';Number of tracks found;' mollerPol.polgem.track.ntrack 11 -0.5 10.5
th1d hmollerPol_polgem_TrackNhits ';Number of hits on first/best track;' mollerPol.polgem.track.nhits[I] 6 -0.5 5.5 singletrack
th1d hmollerPol_polgem_TrackX ';Best track X(z=0), m;' mollerPol.polgem.track.x[I] 200 -0.325 0.325 singletrack
th1d hmollerPol_polgem_TrackY ';Best track Y(z=0), m;' mollerPol.polgem.track.y[I] 200 -1.1 1.1 singletrack
th1d hmollerPol_polgem_TrackXp ';Best track dx/dz;' mollerPol.polgem.track.xp[I] 200 -0.6 0.6 singletrack
th1d hmollerPol_polgem_TrackYp ';Best track dy/dz;' mollerPol.polgem.track.yp[I] 200 -1.2 1.2 singletrack
th2d hmollerPol_polgem_TrackXY 'Best track; y(m); x(m)' mollerPol.polgem.track.y[I] mollerPol.polgem.track.x[I] 150 -1.1 1.1 150 -0.325 0.325 singletrack
th2d hmollerPol_polgem_TrackXpYp 'Best track ;dy/dz;dx/dz' mollerPol.polgem.track.yp[I] mollerPol.polgem.track.xp[I] 150 -1.2 1.2 150 -0.6 0.6 singletrack
th1d hmollerPol_polgem_TrackChi2NDF ';Best track chi2/ndf;' mollerPol.polgem.track.chi2ndf[I] 200 0 200 singletrack

th1d hmollerPol_polgem_residu_allhits 'All hits; Track u/x incl. residuals (m);' mollerPol.polgem.hit.residu 500 -0.0025 0.0025 singletrack
th1d hmollerPol_polgem_residv_allhits 'All hits; Track v/y incl. residuals (m);' mollerPol.polgem.hit.residv 500 -0.0025 0.0025 singletrack
th1d hmollerPol_polgem_eresidu_allhits 'All hits; Track u/x excl. residuals (m);' mollerPol.polgem.hit.eresidu 1000 -0.005 0.005 singletrack
th1d hmollerPol_polgem_eresidv_allhits 'All hits; Track v/y excl. residuals (m);' mollerPol.polgem.hit.eresidv 1000 -0.005 0.005 singletrack
th2d hmollerPol_polgem_residu_vs_layer ';layer; Track u/x incl. residuals (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.residu 5 -0.5 4.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_residv_vs_layer ';layer; Track v/y incl. residuals (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.residv 5 -0.5 4.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_residu_vs_module ';module; Track u/x incl. residuals (m)' mollerPol.polgem.hit.module mollerPol.polgem.hit.residu 20 -0.5 19.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_residv_vs_module ';module; Track v/y incl. residuals (m)' mollerPol.polgem.hit.module mollerPol.polgem.hit.residv 20 -0.5 19.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_eresidu_vs_layer ';layer; Track u/x excl. residuals (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.eresidu 5 -0.5 4.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_eresidv_vs_layer ';layer; Track v/y excl. residuals (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.eresidv 5 -0.5 4.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_eresidu_vs_module ';module; Track u/x excl. residuals (m)' mollerPol.polgem.hit.module mollerPol.polgem.hit.eresidu 20 -0.5 19.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_eresidv_vs_module ';module; Track v/y excl. residuals (m)' mollerPol.polgem.hit.module mollerPol.polgem.hit.eresidv 20 -0.5 19.5 250 -0.0025 0.0025 singletrack
th2d hmollerPol_polgem_hit_xglobal_vs_layer ';layer; Hit x global (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.xglobal 5 -0.5 4.5 250 -0.325 0.325
th2d hmollerPol_polgem_hit_yglobal_vs_layer ';layer; Hit y global (m)' mollerPol.polgem.hit.layer mollerPol.polgem.hit.yglobal 5 -0.5 4.5 250 -1.1 1.1

# Module-specific histograms:
# Module 0 strip histograms, all strips:
th1d hmollerPol_polgem_m0_nstripstot_good 'mollerPol.polgem.m0; Num. fired strips (U/X) + (V/Y);' mollerPol.polgem.m0.strip.nstripsfired 101 -0.5 100.5 mollerPol.polgem.m0.ontrack
th1d hmollerPol_polgem_m0_nclustU_good 'mollerPol.polgem.m0; num. U clusters;' mollerPol.polgem.m0.clust.nclustu 21 0.5 20.5 mollerPol.polgem.m0.ontrack
th1d hmollerPol_polgem_m0_nclustV_good 'mollerPol.polgem.m0; num. V clusters; ' mollerPol.polgem.m0.clust.nclustv 21 0.5 20.5 mollerPol.polgem.m0.ontrack
th1d hmollerPol_polgem_m0_nstripstot_all 'mollerPol.polgem.m0; Num. fired strips (U/X) + (V/Y);' mollerPol.polgem.m0.strip.nstripsfired 101 -0.5 100.5
th1d hmollerPol_polgem_m0_nclustU_all 'mollerPol.polgem.m0; num. U clusters;' mollerPol.polgem.m0.clust.nclustu 21 0.5 20.5
th1d hmollerPol_polgem_m0_nclustV_all 'mollerPol.polgem.m0; num. V clusters;' mollerPol.polgem.m0.clust.nclustv 21 0.5 20.5
th1d hmollerPol_polgem_m0_stripU_all 'mollerPol.polgem.m0; U/X strip index; ' mollerPol.polgem.m0.strip.istrip[I] 192 -0.5 191.5 mollerPol.polgem.m0.strip.IsU[I]
th1d hmollerPol_polgem_m0_stripV_all 'mollerPol.polgem.m0; V/Y strip index; ' mollerPol.polgem.m0.strip.istrip[I] 640 -0.5 639.5 mollerPol.polgem.m0.strip.IsV[I]
th1d hmollerPol_polgem_m0_ADCsumU_all 'mollerPol.polgem.m0; Strip ADC sum, U/X strips;' mollerPol.polgem.m0.strip.ADCsum[I] 1000 0 6000 mollerPol.polgem.m0.strip.IsU[I]
th1d hmollerPol_polgem_m0_ADCsumV_all 'mollerPol.polgem.m0; Strip ADC sum, V/Y strips;' mollerPol.polgem.m0.strip.ADCsum[I] 1000 0 6000 mollerPol.polgem.m0.strip.IsV[I]
